# echodrop — образец конфигурации через переменные окружения / env configuration sample.
#
# Как пользоваться / How to use:
#   1) cp echodrop.env.example echodrop.env — отредактируй значения
#   2) подставь в своё окружение:
#        systemd:  EnvironmentFile=/path/to/echodrop.env   (в юните службы)
#        docker:   docker run --env-file echodrop.env ...
#        shell:    set -a; . ./echodrop.env; set +a; ./echodrop
#   Все переменные опциональны: не задана — используется дефолт, указанный ниже.
#   Any variable may be omitted — the default listed below is used.
#
#   cp echodrop.env.example echodrop.env — edit the values,
#   then feed it to your environment (systemd EnvironmentFile= / docker --env-file / shell sourcing).
#   All variables are optional: omitted → default listed below.

# ─────────────────────────────────────────────────────────────────────────────
# Режим работы сайта / Site mode
# Дефолт / default: free
#
#   free   — только дропзона: загрузка без аккаунтов, короткие ссылки.
#            Личного кабинета нет, страницы /login и /register закрыты.
#            Drop zone only: anonymous uploads, short links, no accounts,
#            /login and /register pages are disabled.
#   open   — дропзона + свободная регистрация пользователей. Появляются ЛК
#            (/my): список своих файлов, удаление. /login и /register открыты.
#            Drop zone + open user registration: personal file cabinet /my
#            (list, delete), /login and /register enabled.
#   closed — режим «свои»: регистрация закрыта, но существующие аккаунты
#            входят как в open (для инстанса, который «заморозили»).
#            Registration closed; existing users sign in as in open mode
#            (useful for a frozen instance).
#ECHODROP_MODE=free

# ─────────────────────────────────────────────────────────────────────────────
# Адрес, который слушает сервер / Server listen address
# Дефолт / default: 0.0.0.0:8080
#
# Формат ip:port. 0.0.0.0 — все интерфейсы; 127.0.0.1 — только локально
# (тогда снаружи — только через reverse-proxy).
# ip:port format. 0.0.0.0 = all interfaces; 127.0.0.1 = localhost only
# (put a reverse-proxy in front for public access).
#ECHODROP_LISTEN=0.0.0.0:8080

# ─────────────────────────────────────────────────────────────────────────────
# Порт (только) / Port override
# Дефолт / default: не задан — порт берётся из ECHODROP_LISTEN / not set,
#                  the port comes from ECHODROP_LISTEN
#
# Перекрывает ТОЛЬКО порт из ECHODROP_LISTEN, IP-часть сохраняется.
# Удобно, когда полный адрес фиксирован, а порт хочет задать оркестратор
# (docker -e, systemd override и т.п.).
# Overrides ONLY the port part of ECHODROP_LISTEN; the IP part stays.
# Handy when the listen address is fixed but an orchestrator (docker -e,
# systemd override) wants to set the port.
#ECHODROP_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Каталог хранения / Storage directory
# Дефолт / default: ./data (создаётся при старте)
#
# Здесь лежат загруженные файлы (по sha256) и база echodrop.db (SQLite).
# Uploaded files (content-addressed by sha256) and the SQLite database
# echodrop.db live here. Created on start.
#ECHODROP_STORAGE_PATH=./data

# ─────────────────────────────────────────────────────────────────────────────
# Максимум размера файла / Max upload size
# Дефолт / default: 100
#
# В мегабайтах. Загрузка больше — HTTP 413.
# In megabytes. Larger uploads get HTTP 413.
#ECHODROP_MAX_FILE_SIZE_MB=100

# ─────────────────────────────────────────────────────────────────────────────
# Срок жизни файла по умолчанию / Default file TTL
# Дефолт / default: 168 (7 суток / 7 days)
#
# В часах. Пользователь может попросить другой срок при загрузке, но не дольше
# ECHODROP_MAX_TTL_HOURS. Значение 0 = «бессрочно по умолчанию» — допустимо
# только при ECHODROP_ALLOW_INFINITE_TTL=true.
# In hours. Users may request another TTL at upload, capped by
# ECHODROP_MAX_TTL_HOURS. 0 = "infinite by default" — only valid with
# ECHODROP_ALLOW_INFINITE_TTL=true.
#ECHODROP_DEFAULT_TTL_HOURS=168

# ─────────────────────────────────────────────────────────────────────────────
# Потолок срока хранения / Max allowed TTL
# Дефолт / default: 720 (30 суток / 30 days)
#
# В часах. Запрос срока дольше — HTTP 400. Значение обязано быть >= 1;
# при старте проверяется, что ECHODROP_DEFAULT_TTL_HOURS <= ECHODROP_MAX_TTL_HOURS.
# In hours. Requests above it get HTTP 400. Must be >= 1; on start it is
# checked that ECHODROP_DEFAULT_TTL_HOURS <= ECHODROP_MAX_TTL_HOURS.
#ECHODROP_MAX_TTL_HOURS=720

# ─────────────────────────────────────────────────────────────────────────────
# Разрешить вечные файлы / Allow infinite-lifetime files
# Дефолт / default: false
#
# true — пользователь может выбрать «бессрочно» (ttl = 0, никогда не истекает).
# false — запрос с ttl = 0 отклоняется (400), вечных файлов на инстансе нет.
# true — users may pick "forever" (ttl = 0, never expires).
# false — ttl = 0 requests are rejected (400); no eternal files on the instance.
#ECHODROP_ALLOW_INFINITE_TTL=false

# ─────────────────────────────────────────────────────────────────────────────
# Трекинг загрузок и скачиваний / Upload & download tracking
# Дефолт / default: false
#
# true — в БД пишется таблица events: кто (IP, отпечаток браузера) и когда
#        загружал/скачивал каждый файл. Нужно для правовой реальности (РКН):
#        по законному запросу владелец инстанса может дать координаты
#        загрузившего. Отпечаток v1 = sha256(User-Agent + Accept-Language +
#        Accept-Encoding).
# false — данные не собираются вовсе: таблица events не создаётся.
# true — an `events` table is written: who (IP, browser fingerprint) and when
#        uploaded/downloaded each file. For legal reality (e.g. RF regulators):
#        on a lawful request the instance owner can produce the uploader's
#        coordinates. Fingerprint v1 = sha256(User-Agent + Accept-Language +
#        Accept-Encoding).
# false — no data collected at all: the events table is never created.
#ECHODROP_TRACKING=false

# ─────────────────────────────────────────────────────────────────────────────
# Название сайта / Site name
# Дефолт / default: echodrop
#
# Отображается в шапке страниц и в <title>.
# Shown in page headers and the <title>.
#ECHODROP_SITE_NAME=echodrop

# ─────────────────────────────────────────────────────────────────────────────
# Публичный адрес сайта / Public site URL
# Дефолт / default: http://localhost:8080
#
# Из него строятся короткие ссылки на файлы (в ответе /upload и ЛК).
# В проде — реальный адрес, например https://files.example.com
# Short file links (upload response, personal cabinet) are built from it.
# In production set the real URL, e.g. https://files.example.com
#ECHODROP_BASE_URL=http://localhost:8080
